# Copiá este archivo como .env y completá los valores reales. NUNCA subas el .env a Git.
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=

# Clave para firmar los tokens JWT (mínimo 32 caracteres). Generala con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Límite de intentos de login (opcionales; estos son los valores por defecto)
# LOGIN_MAX_INTENTOS_USUARIO=5
# LOGIN_MAX_INTENTOS_IP=20
# LOGIN_VENTANA_MINUTOS=15
